{
  "name": "ccsandbox",
  "version": "1.0.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/hrntknr/ccsandbox"
  },
  "bin": {
    "ccsandbox": "./dist/cli.js"
  },
  "files": [
    "dist",
    "web/dist"
  ],
  "scripts": {
    "build": "concurrently -n server,web -c yellow,green \"npm:build:server\" \"npm:build:web\"",
    "build:server": "esbuild src/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js",
    "build:web": "npm run build --prefix web",
    "clean": "rm -rf dist web/dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js",
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --import tsx src/cli.ts",
    "dev:web": "npm run dev --prefix web",
    "postinstall": "npm install --prefix web"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.3",
    "bcrypt": "^6.0.0",
    "commander": "^12.1.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.0",
    "uuid": "^10.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.2",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
