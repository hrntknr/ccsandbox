{
  "name": "ccsandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build && npm run build --workspace=packages/web",
    "clean": "npm run clean --workspaces --if-present",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node packages/cli/dist/index.js",
    "dev": "tsx packages/cli/src/index.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "loupe": "^3.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
