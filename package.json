{
  "name": "ccsandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "clean": "npm run clean --workspaces --if-present",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node packages/cli/dist/index.js",
    "dev": "tsx packages/cli/src/index.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
